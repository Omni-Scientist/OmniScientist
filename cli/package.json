{
  "name": "omnisci",
  "version": "0.1.7",
  "description": "A general DeepSeek V4 Flash terminal harness with an opt-in scientific paper skill",
  "type": "module",
  "bin": {
    "omnisci": "./src/cli.tsx"
  },
  "scripts": {
    "dev": "bun run src/cli.tsx",
    "build": "bun build --compile --minify --define 'process.env.DEV=\"false\"' src/cli.tsx --outfile dist/omnisci",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "ink": "^5.1.0",
    "ink-text-input": "^6.0.0",
    "mathjax-full": "^3.2.2",
    "openai": "^4.77.0",
    "react": "^18.3.1",
    "yaml": "^2.6.1"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/react": "^18.3.12",
    "react-devtools-core": "^7.0.1",
    "typescript": "^5.7.2"
  }
}
