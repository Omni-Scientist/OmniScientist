{
  "compilerOptions": {
    "lib": [
      "ESNext",
      "DOM"
    ],
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "types": [
      "bun"
    ]
  },
  "include": [
    "gateway/**/*",
    "launcher/**/*",
    "tools/**/*",
    "src/types.ts",
    "embedded.d.ts"
  ]
}
