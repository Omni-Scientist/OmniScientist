{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OmniScientist",
  "mainBinaryName": "OmniScientist",
  "version": "0.2.1",
  "identifier": "io.github.omni-scientist.desktop",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "publisher": "Omni-Scientist",
    "targets": "all",
    "externalBin": ["binaries/omnisci-desktop"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0"
    },
    "windows": {
      "nsis": {
        "installerIcon": "icons/installer.ico"
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  }
}
